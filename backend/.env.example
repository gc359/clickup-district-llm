CLICKUP_TOKEN=pk_...
CLICKUP_TEAM_ID=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss-safeguard
MAX_STEPS=5
CORS_ORIGINS=http://localhost:5173
# Must match the exact name of the ClickUp LIST (not the folder/space it lives in)
# that holds helpdesk tickets. Must be created manually before go-live; the backend
# never creates Lists.
CLICKUP_TICKET_LIST_NAME=Support Tickets
# Must match the exact name of the ClickUp FOLDER (containing Docs/pages, e.g.
# "RingCentral KB", "Network KB") that the chatbot searches for help content.
CLICKUP_KB_FOLDER_NAME=Knowledge Base
